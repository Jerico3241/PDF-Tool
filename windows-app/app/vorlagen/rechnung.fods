e:value-type="currency" office:currency="EUR" office:value="100"><text:p>100</text:p></table:table-cell><table:table-cell table:style-name="ZeileEuro" table:formula="of:=IF(OR([.C10]=&quot;&quot;;[.E10]=&quot;&quot;);&quot;&quot;;[.C10]*[.E10])"/></table:table-row><table:table-row table:style-name="zeile"><table:table-cell table:style-name="ZeileZahl" office:value-type="float" office:value="2"><text:p>2</text:p></table:table-cell><table:table-cell table:style-name="Zeile" office:value-type="string"><text:p>[Leistung oder Artikel]</text:p></table:table-cell><table:table-cell table:style-name="ZeileZahl" office:value-type="float" office:value="2"><text:p>2</text:p></table:table-cell><table:table-cell table:style-name="Zeile" office:value-type="string"><text:p>Std.</text:p></table:table-cell><table:table-cell table:style-name="ZeileEuro" office:value-type="currency" office:currency="EUR" office:value="65"><text:p>65</text:p></table:table-cell><table:table-cell table:style-name="ZeileEuro" table:formula="of:=IF(OR([.C11]=&quot;&quot;;[.E11]=&quot;&quot;);&quot;&quot;;[.C11]*[.E11])"/></table:table-row><table:table-row table:style-name="zeile"><table:table-cell table:style-name="ZeileZahl" office:value-type="float" office:value="3"><text:p>3</text:p></table:table-cell><table:table-cell table:style-name="Zeile" office:value-type="string"><text:p>[Leistung oder Artikel]</text:p></table:table-cell><table:table-cell table:style-name="ZeileZahl" office:value-type="float" office:value="1"><text:p>1</text:p></table:table-cell><table:table-cell table:style-name="Zeile" office:value-type="string"><text:p>Pausch.</text:p></table:table-cell><table:table-cell table:style-name="ZeileEuro" office:value-type="currency" office:currency="EUR" office:value="49.9"><text:p>49.9</text:p></table:table-cell><table:table-cell table:style-name="ZeileEuro" table:formula="of:=IF(OR([.C12]=&quot;&quot;;[.E12]=&quot;&quot;);&quot;&quot;;[.C12]*[.E12])"/></table:table-row><table:table-row table:style-name="zeile"><table:table-cell table:style-name="ZeileZahl"/><table:table-cell table:style-name="Zeile"/><table:table-cell table:style-name="ZeileZahl"/><table:table-cell table:style-name="Zeile"/><table:table-cell table:style-name="ZeileEuro"/><table:table-cell table:style-name="ZeileEuro" table:formula="of:=IF(OR([.C13]=&quot;&quot;;[.E13]=&quot;&quot;);&quot;&quot;;[.C13]*[.E13])"/></table:table-row><table:table-row table:style-name="zeile"><table:table-cell table:style-name="ZeileZahl"/><table:table-cell table:style-name="Zeile"/><table:table-cell table:style-name="ZeileZahl"/><table:table-cell table:style-name="Zeile"/><table:table-cell table:style-name="ZeileEuro"/><table:table-cell table:style-name="ZeileEuro" table:formula="of:=IF(OR([.C14]=&quot;&quot;;[.E14]=&quot;&quot;);&quot;&quot;;[.C14]*[.E14])"/></table:table-row><table:table-row><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/></table:table-row><table:table-row table:style-name="zeile"><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell table:style-name="Summe" office:value-type="string"><text:p>Netto</text:p></table:table-cell><table:table-cell table:style-name="SummeEuro" table:formula="of:=SUM([.F10:.F14])"/></table:table-row><table:table-row table:style-name="zeile"><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell table:style-name="Summe" office:value-type="string"><text:p>USt. 19 %</text:p></table:table-cell><table:table-cell table:style-name="SummeEuro" table:formula="of:=ROUND([.F16]*0.19;2)"/></table:table-row><table:table-row table:style-name="hoch"><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell table:style-name="Gesamt" office:value-type="string"><text:p>Gesamt</text:p></table:table-cell><table:table-cell table:style-name="GesamtEuro" table:formula="of:=[.F16]+[.F17]"/></table:table-row><table:table-row><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Bitte überweisen Sie den Betrag innerhalb von 14 Tagen auf das Konto unten. Vielen Dank für Ihren Auftrag!</text:p></table:table-cell><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/></table:table-row><table:table-row><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/></table:table-row><table:table-row><table:table-cell table:style-name="Grau" office:value-type="string"><text:p>[Bank] · IBAN [DE00 0000 0000 0000 0000 00] · BIC [XXXXDEXX] · USt-IdNr. [DE000000000]</text:p></table:table-cell><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/><table:table-cell/></table:table-row></table:table></office:spreadsheet></office:body>
