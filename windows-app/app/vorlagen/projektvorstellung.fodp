<office:body><office:presentation><draw:page draw:name="Titel" draw:style-name="dunkel" draw:master-page-name="Novadesk"><draw:frame draw:style-name="mitte" svg:x="1.6cm" svg:y="4.6cm" svg:width="22.0cm" svg:height="3.0cm"><draw:text-box><text:p text:style-name="gross">[Projektname]</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="7.7cm" svg:width="22.0cm" svg:height="2.6cm"><draw:text-box><text:p text:style-name="unter">[Worum es geht, in einem Satz]</text:p><text:p text:style-name="unter">[Name] · [Datum]</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="leiste" svg:x="1.8cm" svg:y="7.4cm" svg:width="4cm" svg:height="0.15cm"/></draw:page><draw:page draw:name="Ausgangslage" draw:style-name="hell" draw:master-page-name="Novadesk"><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="0.9cm" svg:width="24.8cm" svg:height="1.8cm"><draw:text-box><text:p text:style-name="titel">Ausgangslage</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="3.0cm" svg:width="24.8cm" svg:height="11.0cm"><draw:text-box><text:list text:style-name="punkte"><text:list-item><text:p text:style-name="text">[Was ist heute das Problem?]</text:p></text:list-item><text:list-item><text:p text:style-name="text">[Wen betrifft es?]</text:p></text:list-item><text:list-item><text:p text:style-name="text">[Was kostet es, wenn nichts geschieht?]</text:p></text:list-item></text:list></draw:text-box></draw:frame></draw:page><draw:page draw:name="Ziele" draw:style-name="hell" draw:master-page-name="Novadesk"><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="0.9cm" svg:width="24.8cm" svg:height="1.8cm"><draw:text-box><text:p text:style-name="titel">Ziele</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="kachel" svg:x="1.6cm" svg:y="3.3cm" svg:width="7.6cm" svg:height="9.5cm"><draw:text-box><text:p text:style-name="zahl">1</text:p><text:p text:style-name="text">[Erstes Ziel]</text:p><text:p text:style-name="klein">[Woran man den Erfolg misst]</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="kachel" svg:x="10.2cm" svg:y="3.3cm" svg:width="7.6cm" svg:height="9.5cm"><draw:text-box><text:p text:style-name="zahl">2</text:p><text:p text:style-name="text">[Zweites Ziel]</text:p><text:p text:style-name="klein">[Woran man den Erfolg misst]</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="kachel" svg:x="18.8cm" svg:y="3.3cm" svg:width="7.6cm" svg:height="9.5cm"><draw:text-box><text:p text:style-name="zahl">3</text:p><text:p text:style-name="text">[Drittes Ziel]</text:p><text:p text:style-name="klein">[Woran man den Erfolg misst]</text:p></draw:text-box></draw:frame></draw:page><draw:page draw:name="Zeitplan" draw:style-name="hell" draw:master-page-name="Novadesk"><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="0.9cm" svg:width="24.8cm" svg:height="1.8cm"><draw:text-box><text:p text:style-name="titel">Zeitplan</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="band" svg:x="1.8cm" svg:y="7.2cm" svg:width="24.4cm" svg:height="0.2cm"/><draw:rect draw:style-name="leiste" svg:x="1.8cm" svg:y="6.85cm" svg:width="0.9cm" svg:height="0.9cm"/><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="8.2cm" svg:width="7.6cm" svg:height="4.0cm"><draw:text-box><text:p text:style-name="text">[Monat 1]</text:p><text:p text:style-name="klein">[Start und Planung]</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="leiste" svg:x="9.9cm" svg:y="6.85cm" svg:width="0.9cm" svg:height="0.9cm"/><draw:frame draw:style-name="rahmen" svg:x="9.7cm" svg:y="8.2cm" svg:width="7.6cm" svg:height="4.0cm"><draw:text-box><text:p text:style-name="text">[Monat 2]</text:p><text:p text:style-name="klein">[Umsetzung]</text:p></draw:text-box></draw:frame><draw:rect draw:style-name="leiste" svg:x="18.0cm" svg:y="6.85cm" svg:width="0.9cm" svg:height="0.9cm"/><draw:frame draw:style-name="rahmen" svg:x="17.8cm" svg:y="8.2cm" svg:width="7.6cm" svg:height="4.0cm"><draw:text-box><text:p text:style-name="text">[Monat 3]</text:p><text:p text:style-name="klein">[Abschluss und Übergabe]</text:p></draw:text-box></draw:frame></draw:page><draw:page draw:name="Nächste Schritte" draw:style-name="dunkel" draw:master-page-name="Novadesk"><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="3.0cm" svg:width="24.8cm" svg:height="2.2cm"><draw:text-box><text:p text:style-name="weiss">Nächste Schritte</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="rahmen" svg:x="1.6cm" svg:y="5.4cm" svg:width="24.8cm" svg:height="7.0cm"><draw:text-box><text:p text:style-name="weissklein">[Was wir heute entscheiden möchten]</text:p><text:p text:style-name="weissklein">[Wer macht was bis wann]</text:p><text:p text:style-name="weissklein">Fragen? [E-Mail]</text:p></draw:text-box></draw:frame></draw:page></office:presentation></office:body>
