<office:body><office:text><text:p text:style-name="Title">Bericht</text:p><text:p text:style-name="Subtitle"><text:span text:style-name="Accent">[Thema des Berichts]</text:span> · <text:span text:style-name="Accent">[Abteilung]</text:span> · <text:span text:style-name="Accent">[Monat JJJJ]</text:span></text:p><text:h text:style-name="Heading_20_1" text:outline-level="1">Zusammenfassung</text:h><text:p text:style-name="Standard"><text:span text:style-name="Accent">[Das Wichtigste in drei bis fünf Sätzen: Ausgangslage, Ergebnis und Empfehlung. Wer nur diesen Abschnitt liest, soll Bescheid wissen.]</text:span></text:p><text:h text:style-name="Heading_20_1" text:outline-level="1">Ausgangslage</text:h><text:p text:style-name="Standard"><text:span text:style-name="Accent">[Warum gibt es diesen Bericht? Was war das Ziel, welcher Zeitraum ist betrachtet?]</text:span></text:p><text:h text:style-name="Heading_20_1" text:outline-level="1">Ergebnisse</text:h><text:h text:style-name="Heading_20_2" text:outline-level="2">Kennzahlen</text:h><table:table table:name="Kennzahlen" table:style-name="Kennzahlen"><table:table-column table:style-name="Kennzahlen.C0"/><table:table-column table:style-name="Kennzahlen.C1"/><table:table-column table:style-name="Kennzahlen.C2"/><table:table-column table:style-name="Kennzahlen.C3"/><table:table-header-rows><table:table-row><table:table-cell table:style-name="Kennzahlen.H" office:value-type="string"><text:p text:style-name="Table_20_Heading">Kennzahl</text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.H" office:value-type="string"><text:p text:style-name="Table_20_Heading">Vorjahr</text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.H" office:value-type="string"><text:p text:style-name="Table_20_Heading">Aktuell</text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.H" office:value-type="string"><text:p text:style-name="Table_20_Heading">Veränderung</text:p></table:table-cell></table:table-row></table:table-header-rows><table:table-row><table:table-cell table:style-name="Kennzahlen.S" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[Umsatz]</text:span></text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.D" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[0 €]</text:span></text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.D" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[0 €]</text:span></text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.D" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[+0 %]</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Kennzahlen.S" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[Kunden]</text:span></text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.D" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[0]</text:span></text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.D" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[0]</text:span></text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.D" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[+0 %]</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Kennzahlen.S" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="Accent">[Aufträge]</text:span></text:p></table:table-cell><table:table-cell table:style-name="Kennzahlen.D" 