// Novadesk – Symbol, Versionsangaben und Manifest des Startprogramms PDF-Tool.exe.
// build.py schreibt version.h mit PDFTOOL_VERSION_NUM (z. B. 3,2,0,0) und PDFTOOL_VERSION_STR (z. B. "3.2.0-beta.3").
#include <winver.h>
#include "version.h"

#ifndef PDFTOOL_VERSION_NUM
#define PDFTOOL_VERSION_NUM 0,0,0,0
#endif
#ifndef PDFTOOL_VERSION_STR
#define PDFTOOL_VERSION_STR "0.0.0"
#endif

1 ICON "icon.ico"
// Symbole für die Dateizuordnung (DefaultIcon »PDF-Tool.exe,-<Nummer>«): eigene Nummer je Symbol, damit Windows kein
// altes Symbol aus seinem Zwischenspeicher zeigt – bei einem neuen Symbol eine neue Nummer (siehe PDF-Tool.iss).
// 2: Symbol von PDF Tool 4.0 (nicht mehr verwendet, Nummer bleibt belegt); seit 5.0: 3 App (Novadesk), 10–14 je Dateiart
2 ICON "icon.ico"
3 ICON "icon.ico"
10 ICON "datei-pdf.ico"
11 ICON "datei-text.ico"
12 ICON "datei-tabelle.ico"
13 ICON "datei-praesentation.ico"
14 ICON "datei-csv.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PDFTOOL_VERSION_NUM
 PRODUCTVERSION PDFTOOL_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "Comments", "Startprogramm von Novadesk (Open Source, GPL-3.0): https://github.com/Jerico3241/PDF-Tool"
            VALUE "CompanyName", "Jerico3241"
            VALUE "FileDescription", "Novadesk"
            VALUE "FileVersion", PDFTOOL_VERSION_STR
            VALUE "InternalName", "PDF-Tool"
            VALUE "LegalCopyright", "Copyright (C) 2026 Jerico3241, GPL-3.0"
            VALUE "OriginalFilename", "PDF-Tool.exe"
            VALUE "ProductName", "Novadesk"
            VALUE "ProductVersion", PDFTOOL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
